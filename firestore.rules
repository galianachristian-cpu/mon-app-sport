rules_version = '2';
// Règles de la base Firestore de « Mon Programme ».
// À coller dans la console Firebase : Firestore Database → Règles → Publier.
// Seul le compte ci-dessous peut lire ou écrire (profils Moi et Béa, foyer, sauvegardes).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null
        && request.auth.token.email in ['galiana.christian@gmail.com'];
    }
  }
}
